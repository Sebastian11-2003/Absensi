
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jadwal Pelajaran - SMASVP</title>

    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/kelas.css">
    <link rel="stylesheet" href="/css/jadwal.css">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        <div class="jadwal-header">
            <div>
                <h1>Jadwal Pelajaran</h1>
                <p>Kelola jadwal pelajaran seluruh kelas SMASVP.</p>
            </div>

            <button class="btn-tambah" onclick="bukaModalTambah()">
                + Tambah Jadwal
            </button>
        </div>

        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <section class="jadwal-container">

            <div class="jadwal-filter">
                <div>
                    <label for="filterKelas">Filter Kelas</label>
                    <select id="filterKelas">
                        <option value="">Semua Kelas</option>
                        <% kelas.forEach(k => { %>
                            <option value="<%= k.nama_kelas %>"><%= k.nama_kelas %></option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label for="filterHari">Filter Hari</label>
                    <select id="filterHari">
                        <option value="">Semua Hari</option>
                        <% ['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'].forEach(h => { %>
                            <option value="<%= h %>"><%= h %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="jadwal-table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Hari</th>
                            <th>Jam</th>
                            <th>Kelas</th>
                            <th>Mata Pelajaran</th>
                            <th>Guru</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>

                    <tbody id="jadwalBody">
                        <% if (jadwal.length === 0) { %>
                            <tr>
                                <td colspan="7" class="empty-data">Belum ada jadwal pelajaran.</td>
                            </tr>
                        <% } %>

                        <% jadwal.forEach((j, index) => { %>
                            <tr data-kelas="<%= j.nama_kelas %>" data-hari="<%= j.hari %>">
                                <td><%= index + 1 %></td>
                                <td><span class="hari-badge"><%= j.hari %></span></td>
                                <td>
                                    <%= String(j.jam_mulai).slice(0,5) %>
                                    -
                                    <%= String(j.jam_selesai).slice(0,5) %>
                                </td>
                                <td><strong><%= j.nama_kelas %></strong></td>
                                <td><%= j.nama_mapel %></td>
                                <td><%= j.nama_guru %></td>
                                <td>
                                    <div class="aksi-jadwal">
                                        <button
                                            type="button"
                                            class="btn-edit"
                                            data-id="<%= j.id %>"
                                            data-guru="<%= j.guru_id %>"
                                            data-kelas="<%= j.kelas_id %>"
                                            data-mapel="<%= j.mapel_id %>"
                                            data-hari="<%= j.hari %>"
                                            data-mulai="<%= String(j.jam_mulai).slice(0,5) %>"
                                            data-selesai="<%= String(j.jam_selesai).slice(0,5) %>"
                                            onclick="editJadwal(this)">
                                            Edit
                                        </button>

                                        <form action="/admin/jadwal/hapus/<%= j.id %>" method="POST"
                                              onsubmit="return confirm('Yakin ingin menghapus jadwal ini?')">
                                            <button type="submit" class="btn-hapus">Hapus</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <p id="filterKosong" class="empty-data" style="display:none;">
                Tidak ada jadwal untuk filter yang dipilih.
            </p>
        </section>
    </main>

    <!-- MODAL TAMBAH / EDIT -->
    <div class="modal-jadwal" id="modalJadwal">
        <div class="modal-jadwal-content">
            <div class="modal-jadwal-header">
                <h2 id="judulModal">Tambah Jadwal</h2>
                <button type="button" class="tutup-modal" onclick="tutupModal()">×</button>
            </div>

            <form id="formJadwal" action="/admin/jadwal/tambah" method="POST">

                <div class="form-group">
                    <label>Guru Pengajar</label>
                    <select name="guru_id" id="guru_id" required>
                        <option value="">Pilih Guru</option>
                        <% guru.forEach(g => { %>
                            <option value="<%= g.id %>"><%= g.nama_guru %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Kelas</label>
                    <select name="kelas_id" id="kelas_id" required>
                        <option value="">Pilih Kelas</option>
                        <% kelas.forEach(k => { %>
                            <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Mata Pelajaran</label>
                    <select name="mapel_id" id="mapel_id" required>
                        <option value="">Pilih Mata Pelajaran</option>
                        <% mapel.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.nama_mapel %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Hari</label>
                    <select name="hari" id="hari" required>
                        <option value="">Pilih Hari</option>
                        <% ['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'].forEach(h => { %>
                            <option value="<%= h %>"><%= h %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-row-jadwal">
                    <div class="form-group">
                        <label>Jam Mulai</label>
                        <input type="time" name="jam_mulai" id="jam_mulai" required>
                    </div>

                    <div class="form-group">
                        <label>Jam Selesai</label>
                        <input type="time" name="jam_selesai" id="jam_selesai" required>
                    </div>
                </div>

                <div class="modal-jadwal-actions">
                    <button type="button" class="btn-batal" onclick="tutupModal()">Batal</button>
                    <button type="submit" class="btn-simpan">Simpan Jadwal</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/jadwal.js"></script>
</body>
</html>
