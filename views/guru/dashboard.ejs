
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Guru - SMASVP</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/guru.css">
</head>
<body>

<div class="admin-layout">

    <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <main class="main-content">

        <%- include('partials/header', {
            guru,
            pageTitle: 'Dashboard',
            pageSubtitle: 'Ringkasan aktivitas mengajar Anda'
        }) %>

        <section class="dashboard-content">

            <div class="welcome-section">
                <div>
                    <span class="welcome-label">HALO, GURU</span>
                    <h1>Selamat Datang, <%= guru.nama_guru %>!</h1>
                    <p>Berikut informasi jadwal dan aktivitas mengajar Anda.</p>
                </div>

                <div class="welcome-date">
                    <span id="currentDate"></span>
                </div>
            </div>

            <div class="section-heading">
                <div>
                    <h2>Ringkasan Aktivitas</h2>
                    <p>Informasi kegiatan mengajar Anda</p>
                </div>
            </div>

            <div class="stats-grid">

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon blue">◷</div>
                        <span class="stat-label">JADWAL MENGAJAR</span>
                    </div>
                    <h2><%= statistik.jadwal %></h2>
                    <p>Total jadwal mengajar Anda</p>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon purple">♧</div>
                        <span class="stat-label">PESERTA DIDIK</span>
                    </div>
                    <h2><%= statistik.murid %></h2>
                    <p>Murid dari kelas yang Anda ajar</p>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon green">✓</div>
                        <span class="stat-label">ABSENSI HARI INI</span>
                    </div>
                    <h2><%= statistik.absensi %></h2>
                    <p>Catatan kehadiran hari ini</p>
                </div>

            </div>

            <div class="section-heading schedule-heading">
                <div>
                    <h2>Jadwal Mengajar Hari Ini</h2>
                    <p><%= hariIni %> · <%= tanggalHariIni %></p>
                </div>

                <a href="/guru/jadwal" class="text-link">Lihat Semua Jadwal →</a>
            </div>

            <div class="schedule-list">

                <% if (jadwalHariIni.length === 0) { %>

                    <div class="empty-state">
                        <div class="empty-icon">◷</div>
                        <h3>Tidak Ada Jadwal Mengajar</h3>
                        <p>Anda tidak memiliki jadwal mengajar hari ini.</p>
                    </div>

                <% } else { %>

                    <% jadwalHariIni.forEach((item) => { %>

                        <div class="schedule-card">

                            <div class="schedule-time">
                                <strong><%= String(item.jam_mulai).slice(0, 5) %></strong>
                                <span>sampai</span>
                                <strong><%= String(item.jam_selesai).slice(0, 5) %></strong>
                            </div>

                            <div class="schedule-info">
                                <h3><%= item.nama_mapel %></h3>
                                <p>
                                    <%= item.nama_kelas %> ·
                                    Kelas <%= item.tingkat %> <%= item.jurusan %>
                                </p>
                            </div>

                            <div class="schedule-action">
                                <span class="schedule-badge">Jadwal Hari Ini</span>
                            </div>

                        </div>

                    <% }) %>

                <% } %>

            </div>

            <div class="section-heading schedule-heading">
                <div>
                    <h2>Ringkasan Absensi Hari Ini</h2>
                    <p>Status kehadiran murid yang sudah dicatat</p>
                </div>
            </div>

            <div class="attendance-summary">

                <div class="attendance-item">
                    <span class="attendance-dot hadir"></span>
                    <div>
                        <strong><%= ringkasan.hadir || 0 %></strong>
                        <span>Hadir</span>
                    </div>
                </div>

                <div class="attendance-item">
                    <span class="attendance-dot izin"></span>
                    <div>
                        <strong><%= ringkasan.izin || 0 %></strong>
                        <span>Izin</span>
                    </div>
                </div>

                <div class="attendance-item">
                    <span class="attendance-dot sakit"></span>
                    <div>
                        <strong><%= ringkasan.sakit || 0 %></strong>
                        <span>Sakit</span>
                    </div>
                </div>

                <div class="attendance-item">
                    <span class="attendance-dot alpa"></span>
                    <div>
                        <strong><%= ringkasan.alpa || 0 %></strong>
                        <span>Alpa</span>
                    </div>
                </div>

            </div>

            <div class="dashboard-footer">
                <span>© 2026 SMASVP</span>
                <span>Sistem Informasi Absensi Sekolah</span>
            </div>

        </section>

    </main>

</div>

<script src="/js/guru.js"></script>

</body>
</html>
